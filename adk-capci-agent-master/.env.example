# ── Capci MCP connection ─────────────────────────────────────────────────────
# Hosted Capci MCP endpoint (default). Point at a local server if you run one.
CAPCI_MCP_URL=https://mcp.capci.app/mcp
# Your Capci API key: capci.app → Dashboard → Account → API & MCP → Generate API Key.
# Free keys work as a one-time trial; Pro (200/mo) and Developer (900/mo) get a
# recurring quota. Shown once at creation — copy it immediately.
CAPCI_API_KEY=capci_your_api_key_here
# The agent uses gemini-2.5-pro (set in agent.py) — reliable native
# function-calling. Avoid gemini-2.5-flash: it can loop or emit code-style tool
# calls (UNEXPECTED_TOOL_CALL).

# ── Gemini access — pick ONE of the two blocks below ─────────────────────────
# A) Google AI Studio (simplest):
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_aistudio_api_key

# B) Vertex AI (comment out block A, uncomment these):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
